# Menu
menu.border.color: #cdb4b0

menu.title.bg: Solid Flat
menu.title.bg.color: #1f1f1e
menu.title.bg.shadow: 0
menu.title.text.color: #cdb4b0
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #1f1f1e
menu.items.text.color: #cdb4b0
menu.items.disabled.text.color: #a18e8b

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #86663a
menu.items.active.text.color: #cdb4b0

menu.separator.color: #a18e8b
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #1f1f1e

# Active window
window.active.border.color: #86663a


window.active.title.bg: flat solid
window.active.title.bg.color: #1f1f1e
window.active.title.separator.color: #1f1f1e
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #cdb4b0

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1f1f1e

window.active.grip.bg: flat solid
window.active.grip.bg.color: #1f1f1e

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #1f1f1e
window.active.button.unpressed.image.color: #cdb4b0

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #86663a
window.active.button.pressed.image.color: #1f1f1e

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #1f1f1e
window.active.button.disabled.image.color: #a18e8b

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1f1f1e
window.active.button.hover.image.color: #86663a

#window.active.button.toggled.bg: #86663a
#window.active.button.toggled.image.color: #1f1f1e

# Inactive window
window.inactive.border.color: #1f1f1e

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1f1f1e
window.inactive.title.separator.color: #1f1f1e
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #a18e8b

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1f1f1e

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1f1f1e

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #1f1f1e
window.inactive.button.unpressed.image.color: #a18e8b

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #86663a
window.inactive.button.pressed.image.color: #1f1f1e

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #a18e8b
window.inactive.button.disabled.image.color: #1f1f1e

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1f1f1e
window.inactive.button.hover.image.color: #86663a


# OSD
osd.border.width: 1
osd.border.color: #86663a

osd.bg: flat solid
osd.bg.color: #1f1f1e
osd.label.bg: flat solid
osd.label.bg.color: #1f1f1e
osd.label.text.color: #cdb4b0

# OSD
osd.bg: Solid Flat
osd.bg.color: #1f1f1e
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #86663a
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #1f1f1e

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #a6432c
#osd.button.unpressed.*.border.color: #cdb4b0

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #86663a
#osd.button.pressed.*.border.color: #1f1f1e

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #cdb4b0
#osd.button.focused.*.border.color: #1f1f1e

osd.button.focused.box.color: #86663a


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
